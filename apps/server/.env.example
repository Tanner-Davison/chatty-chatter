# Copy to .env for local development. Heroku sets these as config vars.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/chatty
# Any random string of 32+ characters: openssl rand -hex 32
JWT_SECRET=
PORT=3001
# Optional: extra comma-separated CORS origins on top of the built-in list
CORS_ORIGINS=
CLOUD_NAME=dezclgtpg
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=
# Where emailed links point (production default: https://chattychatter.com)
APP_URL=http://localhost:3000
# Resend sending key; without one, emails are written to the server log
RESEND_API_KEY=
EMAIL_FROM=Chatty Chatter <noreply@mail.chattychatter.com>
# Pop-up alerts (Web Push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
