# Copy to .env for local development. Heroku sets these as config vars.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/chatty
# Any random string of 32+ characters: openssl rand -hex 32
JWT_SECRET=
PORT=3001
# Optional: extra comma-separated CORS origins on top of the built-in list
CORS_ORIGINS=
CLOUD_NAME=dezclgtpg
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=
