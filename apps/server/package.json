{
  "name": "@chatty/server",
  "version": "1.0.0",
  "description": "Chatty Chatter API and Socket.IO server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.2",
    "multer": "2.5.0",
    "socket.io": "4.8.4",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chatty/shared": "*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server-core": "11.3.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
